@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> T
@model IReadOnlyList<DigitalniProdukty.Models.SerialNum.SerialNumberModel>

@{
    ViewData["Title"] = T["Account.Serials.Title"];
}

<div class="app-card" id="serials-card">
    <div class="app-card-header">
        <h1 class="app-card-title">@ViewData["Title"]</h1>
        <partial name="_AccountNav" />
    </div>

    <div class="app-card-body space-y-6">
        <p class="text-sm text-slate-700">@T["Account.Serials.Description"]</p>

        @if (Model.Count == 0)
        {
            <div class="app-callout app-callout-info">
                @T["Account.Serials.Empty"]
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="app-table min-w-full table-fixed text-xs">
                    <thead class="text-left text-slate-500">
                        <tr>
                            <th class="py-1 pr-2">@T["Account.Serials.Table.Key"]</th>
                            <th class="py-1 pr-3 w-28">@T["Account.Serials.Table.MaxDevices"]</th>
                            <th class="py-1 pr-2 w-36">@T["Account.Serials.Table.Created"]</th>
                            <th class="py-1 pr-0 w-28 whitespace-nowrap">@T["Account.Serials.Table.Status"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="py-1 pr-2 font-mono text-slate-900 whitespace-nowrap">@item.Key</td>
                                <td class="py-1 pr-3 whitespace-nowrap">@item.MaxDevices</td>
                                <td class="py-1 pr-2 text-slate-500 whitespace-nowrap">@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="py-1 pr-0 whitespace-nowrap">
                                    @if (item.IsRevoked)
                                    {
                                        <span class="inline-flex min-w-24 justify-center rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700">@T["Account.Serials.Status.Invalid"]</span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex min-w-24 justify-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">@T["Account.Serials.Status.Active"]</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
