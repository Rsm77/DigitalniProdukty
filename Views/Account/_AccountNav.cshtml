@using Microsoft.Extensions.Localization
@using DigitalniProdukty.Security
@inject IStringLocalizer<SharedResources> T

@{
    var path = (Context.Request.Path.Value ?? string.Empty).ToLowerInvariant();
    var isProfile = path == "/account" || path == "/account/";
    var isPassword = path.StartsWith("/account/password");
    var isTwoFactor = path.StartsWith("/account/2fa");
    var isSerials = path.StartsWith("/account/serials");

    const string btnBase = "px-3 py-2 text-sm";
    string cls(bool active) => active ? $"app-btn-primary {btnBase}" : $"app-btn-secondary {btnBase}";
}

<nav class="flex flex-wrap items-center gap-2" aria-label="@T["Account.Nav.Label"]">
    <a class="@cls(isProfile)" asp-controller="Account" asp-action="Profile">@T["Account.Nav.Profile"]</a>
    <a class="@cls(isPassword)" asp-controller="Account" asp-action="Password">@T["Account.Nav.Password"]</a>
    <a class="@cls(isTwoFactor)" asp-controller="Account" asp-action="TwoFactor">@T["Account.Nav.TwoFactor"]</a>
    @if (!User.IsInRole(Authz.Roles.Owner))
    {
        <a class="@cls(isSerials)" asp-controller="Account" asp-action="Serials">@T["Account.Nav.Serials"]</a>
    }
</nav>

@*
Podrobnosti (k čemu slouží, volání, data, HTMX)

- Účel:
    - Navigační lišta pro sekci „Můj účet“ (profil / heslo / 2FA / serials).
    - Zvýrazňuje aktivní záložku podle aktuální URL cesty.

- Kdy / jak / kým je volán:
    - Vkládá se do hlaviček account view přes `<partial name="_AccountNav" />`.

- Datové napojení:
    - Nepoužívá `@model`; rozhoduje podle `Context.Request.Path`.
    - Podmíněně skrývá odkaz na serialy pro roli Owner (`User.IsInRole(Authz.Roles.Owner)`).
    - Texty jsou lokalizované přes `SharedResources`.

- HTMX prvky a princip:
    - Samotný nav nepoužívá `hx-*` atributy.
    - Kliky na odkazy typicky proběhnou přes globální HTMX navigaci (`hx-boost` v layoutu) a obsah se vymění do `#main`.
*@
