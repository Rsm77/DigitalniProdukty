@model DigitalniProdukty.Models.Account.ChangePasswordInputModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> T

@{
    ViewData["Title"] = ViewData["Title"] ?? T["Account.Password.Title"].Value;
    var hasPassword = ViewData["HasPassword"] as bool? ?? true;
}

<div class="app-card" id="password-card">
    <div class="app-card-header">
        <h1 class="app-card-title">@T["Account.Password.Heading"]</h1>
        <partial name="_AccountNav" />
    </div>

    <partial name="_Toast" />

    <div class="app-card-body">
        @if (!hasPassword)
        {
            <div class="mb-4 app-callout app-callout-warning">@T["Account.Password.NoPassword"]</div>
        }

        <div asp-validation-summary="All" class="mb-4"></div>

        <form id="password-form" 
              method="post" 
              class="app-form" 
              novalidate
              hx-post="@Url.Action("Password", "Account")" 
              hx-target="#password-card" 
              hx-swap="outerHTML">
            <div class="app-form-section">
                <div class="app-form-section-heading">
                    <div class="app-form-section-title">@T["Account.Password.Section.Change"]</div>
                    <div class="app-form-section-help">@T["Account.Password.Section.ChangeHelp"]</div>
                </div>

                <div class="app-form-section-fields">
                    <div class="app-field">
                        <label asp-for="CurrentPassword"></label>
                        <input asp-for="CurrentPassword" autocomplete="current-password" disabled="@(!hasPassword)" />
                        <span asp-validation-for="CurrentPassword"></span>
                    </div>

                    <div class="app-field">
                        <label asp-for="NewPassword"></label>
                        <input asp-for="NewPassword" autocomplete="new-password" disabled="@(!hasPassword)" />
                        <span asp-validation-for="NewPassword"></span>
                    </div>

                    <div class="app-field">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" autocomplete="new-password" disabled="@(!hasPassword)" />
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end">
                <button type="submit" class="app-btn-primary" disabled="@(!hasPassword)">
                    <span class="htmx-indicator items-center gap-2">
                        <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </span>
                    <span class="htmx-content">@T["Account.Password.Save"]</span>
                </button>
            </div>
        </form>
    </div>
</div>

@*
Podrobnosti (k čemu slouží, volání, data, HTMX)

- Účel:
    - Změna hesla pro přihlášeného uživatele.
    - Pokud účet nemá lokální heslo (např. externí login), může být změna hesla zakázaná (`hasPassword == false`).

- Kdy / jak / kým je volán:
    - GET: `AccountController.Password()` vrací view; v `ViewData["HasPassword"]` indikuje, zda lze heslo měnit.
    - POST: `AccountController.Password(ChangePasswordInputModel)` provede změnu hesla.

- Datové napojení:
    - `@model ChangePasswordInputModel`:
        - `CurrentPassword`, `NewPassword`, `ConfirmPassword` se bindují přes `asp-for`.
    - `ViewData["HasPassword"]` řídí:
        - zobrazení varování,
        - `disabled` na inputech a submit tlačítku.
    - `_AccountNav` a `_Toast` fungují stejně jako na profilu.

- HTMX prvky a princip:
    - Formulář používá `hx-post` na `Account/Password`.
    - `hx-target="#password-card"` + `hx-swap="outerHTML"`:
        - po validaci/uložení server vrátí celý card a HTMX jej nahradí.
*@

