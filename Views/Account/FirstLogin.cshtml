@model DigitalniProdukty.Models.Account.FirstLoginInputModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> T

@{
    ViewData["Title"] = ViewData["Title"] ?? T["Account.FirstLogin.Title"].Value;
    var currentEmail = (ViewData["CurrentEmail"] as string) ?? string.Empty;
}

<div class="app-card" id="first-login-card">
    <div class="app-card-header">
        <h1 class="app-card-title">@T["Account.FirstLogin.Heading"]</h1>
    </div>

    <partial name="_Toast" />

    <div class="app-card-body">
        <div class="mb-4 app-callout app-callout-warning">
            @T["Account.FirstLogin.Callout"]
        </div>

        @if (!string.IsNullOrWhiteSpace(currentEmail))
        {
            <div class="mb-4 text-sm text-slate-600">
                @T["Account.FirstLogin.CurrentEmail", currentEmail]
            </div>
        }

        <div asp-validation-summary="All" class="mb-4"></div>

        <form id="first-login-form"
              method="post"
              class="app-form"
              novalidate
              hx-post="@Url.Action("FirstLogin", "Account")"
              hx-target="#first-login-card"
              hx-swap="outerHTML">
            @Html.AntiForgeryToken()

            <div class="app-form-section">
                <div class="app-form-section-heading">
                    <div class="app-form-section-title">@T["Account.FirstLogin.Section.Credentials"]</div>
                    <div class="app-form-section-help">@T["Account.FirstLogin.Section.CredentialsHelp"]</div>
                </div>

                <div class="app-form-section-fields">
                    <div class="app-field">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" autocomplete="email" />
                        <span asp-validation-for="Email"></span>
                    </div>

                    <div class="app-field">
                        <label asp-for="CurrentPassword"></label>
                        <input asp-for="CurrentPassword" autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword"></span>
                    </div>

                    <div class="app-field">
                        <label asp-for="NewPassword"></label>
                        <input asp-for="NewPassword" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword"></span>
                    </div>

                    <div class="app-field">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end">
                <button type="submit" class="app-btn-primary">
                    <span class="htmx-indicator items-center gap-2">
                        <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </span>
                    <span class="htmx-content">@T["Account.FirstLogin.Save"]</span>
                </button>
            </div>
        </form>
    </div>
</div>
