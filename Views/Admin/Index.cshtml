@model DigitalniProdukty.Controllers.AdminController.IndexVm

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<DigitalniProdukty.SharedResources> T

@{
    ViewData["Title"] = T["Admin.Index.Title"].Value;
}

<div class="app-card" id="admin-index">
    <div class="app-card-header">
        <h1 class="app-card-title">@ViewData["Title"]</h1>
    </div>

    <partial name="_Toast" />

    <div class="app-card-body space-y-8">
        <section class="space-y-3">
            <h2 class="text-sm font-semibold text-slate-900">@T["Admin.Users.Title"]</h2>

            <div class="overflow-x-auto">
                <table class="app-table min-w-full table-fixed text-xs">
                    <thead class="text-left text-slate-500">
                        <tr>
                            <th class="py-1 pr-4 w-80">@T["Admin.Users.Table.Email"]</th>
                            <th class="py-1 pr-4 w-56">@T["Admin.Users.Table.DisplayName"]</th>
                            <th class="py-1 pr-4 w-36">@T["Admin.Users.Table.Role"]</th>
                            <th class="py-1 pr-4 w-80">@T["Admin.Users.Table.Group"]</th>
                            <th class="py-1 pr-0 w-32">@T["Admin.Users.Table.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var u in Model.Users)
                        {
                            var formId = $"user-{u.Id}";
                            var isProtected = string.Equals(u.Role, DigitalniProdukty.Security.Authz.Roles.Admin, StringComparison.Ordinal)
                                              || string.Equals(u.Role, DigitalniProdukty.Security.Authz.Roles.Owner, StringComparison.Ordinal);
                            <tr>
                                <td class="py-1 pr-4 text-slate-900 whitespace-nowrap">
                                    <div>@u.Email</div>
                                    <div class="font-mono text-slate-500 text-[11px]">@u.Id</div>
                                </td>
                                <td class="py-1 pr-4">
                                    @if (isProtected)
                                    {
                                        <div class="text-slate-900">@(u.DisplayName ?? "—")</div>
                                        <div class="text-[11px] text-slate-500">@T["Admin.Users.ProtectedAccount"]</div>
                                    }
                                    else
                                    {
                                        <input name="DisplayName" form="@formId" value="@u.DisplayName" />
                                    }
                                </td>
                                <td class="py-1 pr-4">
                                    <div class="flex items-center gap-3">
                                        @if (isProtected)
                                        {
                                            <div class="text-slate-900">@u.Role</div>
                                        }
                                        else
                                        {
                                            <select name="Role" form="@formId">
                                                @foreach (var r in Model.Roles)
                                                {
                                                    if (string.Equals(u.Role, r, StringComparison.Ordinal))
                                                    {
                                                        <option value="@r" selected>@r</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@r">@r</option>
                                                    }
                                                }
                                            </select>
                                        }
                                    </div>
                                </td>
                                <td class="py-1 pr-4">
                                    @if (string.Equals(u.Role, DigitalniProdukty.Security.Authz.Roles.Admin, StringComparison.Ordinal)
                                         || string.Equals(u.Role, DigitalniProdukty.Security.Authz.Roles.Owner, StringComparison.Ordinal))
                                    {
                                        <div class="text-slate-900">—</div>
                                        <div class="text-[11px] text-slate-500">@T["Admin.Users.GroupNotApplicable"]</div>
                                        <input type="hidden" name="GroupId" form="@formId" value="" />
                                    }
                                    else if (string.Equals(u.Role, DigitalniProdukty.Security.Authz.Roles.Distributor, StringComparison.Ordinal))
                                    {
                                        <div class="text-slate-900">@(u.GroupName ?? "—")</div>
                                        <div class="text-[11px] text-slate-500">@T["Admin.Users.GroupAuto"]</div>
                                        <input type="hidden" name="GroupId" form="@formId" value="@u.GroupId" />
                                    }
                                    else
                                    {
                                        <select name="GroupId" form="@formId">
                                            <option value="">—</option>
                                            @foreach (var g in Model.Groups)
                                            {
                                                if (u.GroupId == g.Id)
                                                {
                                                    <option value="@g.Id" selected>@g.Name</option>
                                                }
                                                else
                                                {
                                                    <option value="@g.Id">@g.Name</option>
                                                }
                                            }
                                        </select>
                                    }
                                </td>
                                <td class="py-1 pr-0">
                                    @if (isProtected)
                                    {
                                        <div class="text-right text-slate-500">—</div>
                                    }
                                    else
                                    {
                                        <form id="@formId" method="post" asp-controller="Admin" asp-action="UpdateUser">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="UserId" value="@u.Id" />
                                            <div class="flex items-center justify-end">
                                                <button type="submit" class="app-btn-secondary whitespace-nowrap">@T["Admin.Users.Save"]</button>
                                            </div>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-xs text-slate-500">@T["Admin.Users.Help"]</div>
        </section>
    </div>
</div>

@*
Podrobnosti (k čemu slouží, volání, data, HTMX)

- Účel:
    - Admin stránka pro správu uživatelů: přehled uživatelů, editace `DisplayName`, přiřazení role a (dle role) skupiny.
    - Chrání „protected“ účty (Admin/Owner) před změnami z UI.

- Kdy / jak / kým je volán:
    - Renderuje se z `AdminController.Index()` pro uživatele s rolí/povolením admin.
    - Jednotlivé změny se odesílají přes POST na `AdminController.UpdateUser()`.

- Datové napojení:
    - `@model AdminController.IndexVm`:
        - `Users`: seznam uživatelů pro tabulku.
        - `Roles`: dostupné role pro `<select>`.
        - `Groups`: dostupné skupiny pro `<select>`.
    - Formuláře používají klasické MVC binding přes `name="..."` (např. `DisplayName`, `Role`, `GroupId`, `UserId`).
    - `@Html.AntiForgeryToken()` zajišťuje CSRF ochranu pro POST.
    - Zobrazuje `<partial name="_Toast" />` pro hlášky z `TempData`.

- HTMX prvky a princip:
    - View nepoužívá `hx-*` atributy; odeslání je klasický POST.
    - Díky globálnímu `hx-boost` může být samotná navigace na tuto stránku „boostnutá“ (bez reloadu), ale formuláře zůstávají standardní.
*@
