@model DigitalniProdukty.Controllers.AdminController.IndexVm

@using Microsoft.Extensions.Localization
@inject IStringLocalizer<DigitalniProdukty.SharedResources> T

@{
    ViewData["Title"] = T["Admin.Index.Title"].Value;
}

<div class="app-card" id="admin-index">
    <div class="app-card-header">
        <h1 class="app-card-title">@ViewData["Title"]</h1>
    </div>

    <partial name="_Toast" />

    <div class="app-card-body space-y-8">
        <section class="space-y-3">
            <h2 class="text-sm font-semibold text-slate-900">@T["Admin.Groups.Title"]</h2>

            <form method="post" class="app-form" asp-controller="Admin" asp-action="CreateGroup">
                @Html.AntiForgeryToken()

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-4">
                    <div class="app-field sm:col-span-2">
                        <label>@T["Admin.Groups.Create.Name"]</label>
                        <input name="Name" type="text" />
                    </div>

                    <div class="app-field">
                        <label>@T["Admin.Groups.Create.Role"]</label>
                        <select name="Role" required>
                            <option value="">—</option>
                            <option value="Distributor">Distributor</option>
                            <option value="Reseller">Reseller</option>
                        </select>
                    </div>

                    <div class="sm:col-span-2 flex items-end justify-end">
                        <button type="submit" class="app-btn-primary">@T["Admin.Groups.Create.Button"]</button>
                    </div>
                </div>
            </form>

            <div class="overflow-x-auto">
                <table class="app-table min-w-full table-fixed text-xs">
                    <thead class="text-left text-slate-500">
                        <tr>
                            <th class="py-1 pr-4 w-64">@T["Admin.Groups.Table.Name"]</th>
                            <th class="py-1 pr-4 w-36">@T["Admin.Groups.Table.Role"]</th>
                            <th class="py-1 pr-4 w-28">@T["Admin.Groups.Table.Members"]</th>
                            <th class="py-1 pr-0">@T["Admin.Groups.Table.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var g in Model.Groups)
                        {
                            <tr>
                                <td class="py-1 pr-4 text-slate-900">
                                    <span class="font-mono text-slate-500 text-[11px]">@g.Id</span>
                                    <div>@g.Name</div>
                                </td>
                                <td class="py-1 pr-4 text-slate-700 whitespace-nowrap">@g.Role</td>
                                <td class="py-1 pr-4 text-slate-700 whitespace-nowrap">@g.Members</td>
                                <td class="py-1 pr-0">
                                    <form method="post" class="app-form" asp-controller="Admin" asp-action="RenameGroup">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="Id" value="@g.Id" />

                                        <div class="flex items-center justify-end gap-2">
                                            <input name="Name" type="text" value="@g.Name" class="max-w-xs" />
                                            <select name="Role">
                                                @if (string.Equals(g.Role, "Distributor", StringComparison.Ordinal))
                                                {
                                                    <option value="Distributor" selected>Distributor</option>
                                                    <option value="Reseller">Reseller</option>
                                                }
                                                else
                                                {
                                                    <option value="Distributor">Distributor</option>
                                                    <option value="Reseller" selected>Reseller</option>
                                                }
                                            </select>
                                            <button type="submit" class="app-btn-secondary whitespace-nowrap">@T["Admin.Groups.Rename.Button"]</button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="space-y-3">
            <h2 class="text-sm font-semibold text-slate-900">@T["Admin.Users.Title"]</h2>

            <div class="overflow-x-auto">
                <table class="app-table min-w-full table-fixed text-xs">
                    <thead class="text-left text-slate-500">
                        <tr>
                            <th class="py-1 pr-4 w-80">@T["Admin.Users.Table.Email"]</th>
                            <th class="py-1 pr-4 w-36">@T["Admin.Users.Table.Role"]</th>
                            <th class="py-1 pr-4 w-80">@T["Admin.Users.Table.Group"]</th>
                            <th class="py-1 pr-0 w-32">@T["Admin.Users.Table.Actions"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var u in Model.Users)
                        {
                            var formId = $"user-{u.Id}";
                            <tr>
                                <td class="py-1 pr-4 text-slate-900 whitespace-nowrap">
                                    <div>@u.Email</div>
                                    <div class="font-mono text-slate-500 text-[11px]">@u.Id</div>
                                </td>
                                <td class="py-1 pr-4">
                                    <div class="flex items-center gap-3">
                                        <select name="Role" form="@formId">
                                            @foreach (var r in Model.Roles)
                                            {
                                                if (string.Equals(u.Role, r, StringComparison.Ordinal))
                                                {
                                                    <option value="@r" selected>@r</option>
                                                }
                                                else
                                                {
                                                    <option value="@r">@r</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </td>
                                <td class="py-1 pr-4">
                                    <select name="GroupId" form="@formId">
                                        <option value="">—</option>
                                        @foreach (var g in Model.Groups)
                                        {
                                            if (u.GroupId == g.Id)
                                            {
                                                <option value="@g.Id" selected>@g.Name</option>
                                            }
                                            else
                                            {
                                                <option value="@g.Id">@g.Name</option>
                                            }
                                        }
                                    </select>
                                </td>
                                <td class="py-1 pr-0">
                                    <form id="@formId" method="post" asp-controller="Admin" asp-action="UpdateUser">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="UserId" value="@u.Id" />
                                        <div class="flex items-center justify-end">
                                            <button type="submit" class="app-btn-secondary whitespace-nowrap">@T["Admin.Users.Save"]</button>
                                        </div>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="text-xs text-slate-500">@T["Admin.Users.Help"]</div>
        </section>
    </div>
</div>
