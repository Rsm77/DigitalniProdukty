@model IReadOnlyList<DigitalniProdukty.Models.SerialNum.SerialNumberModel>

@using Microsoft.Extensions.Localization
@using DigitalniProdukty.Security
@using DigitalniProdukty.Models.Licensing
@inject IStringLocalizer<SharedResources> T

@{
    ViewData["Title"] = T["LicensingAdmin.Index.Title"].Value;
}

<div class="app-card" id="licensing-admin">
    <div class="app-card-header">
        <h1 class="app-card-title">@ViewData["Title"]</h1>
    </div>

    <partial name="_Toast" />

    <div class="app-card-body space-y-6">
        <authorize roles="@Authz.Roles.Admin">
            @{
                var groups = ViewData["KeyGroups"] as IReadOnlyList<KeyGroupModel>;
                var selectedGroupId = ViewData["SelectedGroupId"] as Guid?;
            }

            <form method="get" class="app-form">
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-4">
                    <div class="app-field sm:col-span-2">
                        <label>Skupina</label>
                        <select name="groupId">
                            <option value="">Vše (admin pool + všechny skupiny)</option>
                            @if (groups is not null)
                            {
                                foreach (var g in groups)
                                {
                                    if (selectedGroupId == g.Id)
                                    {
                                        <option value="@g.Id" selected>@g.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@g.Id">@g.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="sm:col-span-2 flex items-end justify-end">
                        <button type="submit" class="app-btn-secondary">Zobrazit</button>
                    </div>
                </div>
            </form>
        </authorize>

        <partial name="_LatestKeys" model="Model" />
    </div>

    <dialog id="license-details" class="app-dialog">
        <div class="app-card">
            <div class="app-card-header">
                <h2 class="app-card-title">@T["LicensingAdmin.Details.Title"]</h2>
                <div class="flex items-center gap-2">
                    <button type="button" class="app-btn-secondary" onclick="window.appLicensing?.closeDetails?.();">@T["LicensingAdmin.Details.Close"]</button>
                </div>
            </div>

            <div class="app-card-body" id="license-details-body"></div>
        </div>
    </dialog>
</div>

@*
Podrobnosti (k čemu slouží, volání, data, HTMX)

- Účel:
    - Hlavní „Licensing admin“ stránka pro práci s licenčními klíči (serial numbers):
        - (pro Admin roli) možnost filtrovat kontext podle `groupId` (skupina),
        - zobrazení posledních klíčů (partial `_LatestKeys`),
        - připravený `<dialog>` pro detail klíče.

- Kdy / jak / kým je volán:
    - GET: `LicensingAdminController.Index(groupId?)` vrací toto view.
    - Stránka je dostupná jen uživatelům s oprávněními pro správu licencí (policy/role řeší controller).

- Datové napojení:
    - `@model IReadOnlyList<SerialNumberModel>`: seznam „posledních klíčů“ pro tabulku v `_LatestKeys`.
    - `ViewData["KeyGroups"]`: seznam skupin (`IReadOnlyList<KeyGroupModel>`) pro admin filtr.
    - `ViewData["SelectedGroupId"]`: aktuálně zvolená skupina (`Guid?`) pro filtrování.
    - `_Toast` zobrazuje stavové hlášky z `TempData`.

- HTMX prvky a princip:
    - Toto view samo nepoužívá `hx-*` přímo, ale:
        - vkládá partial `_LatestKeys`, který se umí sám obnovovat přes HTMX event `licensing-updated`.
        - připravuje modal/dialog `#license-details` a kontejner `#license-details-body`, do kterého se typicky přes HTMX dotahují detaily (`_Details`).
    - Otevírání detailu je řešené klientským JS hookem `window.appLicensing?.openDetails?.(url)` (viz tlačítka v `_LatestKeys`).
*@
