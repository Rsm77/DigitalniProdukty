@model DigitalniProdukty.Models.SerialNum.SerialNumberModel

@using Microsoft.Extensions.Localization
@using DigitalniProdukty.Security
@using DigitalniProdukty.Models.Licensing
@inject IStringLocalizer<SharedResources> T

@{
    var selectedGroupId = ViewData["SelectedGroupId"] as Guid?;
    var groups = ViewData["KeyGroups"] as IReadOnlyList<KeyGroupModel>;
}

<partial name="_Toast" />

<div class="space-y-4">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div>
            <div class="text-xs font-semibold text-slate-500">@T["LicensingAdmin.Index.Table.Id"]</div>
            <div class="text-sm text-slate-900">@Model.Id</div>
        </div>

        <div>
            <div class="text-xs font-semibold text-slate-500">@T["LicensingAdmin.Index.Table.Created"]</div>
            <div class="text-sm text-slate-900">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
        </div>

        <div class="sm:col-span-2">
            <div class="text-xs font-semibold text-slate-500">@T["LicensingAdmin.Index.Table.Key"]</div>
            <div class="font-mono text-sm text-slate-900 break-all">@Model.Key</div>
        </div>

        <div>
            <div class="text-xs font-semibold text-slate-500">@T["LicensingAdmin.Index.Table.MaxDevices"]</div>
            <div class="text-sm text-slate-900">@Model.MaxDevices</div>
        </div>

        <div>
            <div class="text-xs font-semibold text-slate-500">@T["LicensingAdmin.Index.Table.Status"]</div>
            <div>
                @if (Model.IsRevoked)
                {
                    <span class="inline-flex min-w-24 justify-center rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700">@T["LicensingAdmin.Index.Status.Revoked"]</span>
                }
                else
                {
                    <span class="inline-flex min-w-24 justify-center rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">@T["LicensingAdmin.Index.Status.Active"]</span>
                }
            </div>
        </div>

        <div class="sm:col-span-2">
            <div class="text-xs font-semibold text-slate-500">@T["LicensingAdmin.Index.Table.Assigned"]</div>
            <div class="text-sm text-slate-900">
                @if (string.IsNullOrWhiteSpace(Model.OwnerUserId))
                {
                    <span class="text-slate-500">—</span>
                }
                else
                {
                    <span>@(Model.OwnerUser?.Email ?? Model.OwnerUserId)</span>
                }
            </div>
        </div>
    </div>

    <div class="space-y-2">
        @if (string.IsNullOrWhiteSpace(Model.OwnerUserId))
        {
            <form method="post"
                  class="app-form"
                  hx-post="@Url.Action("Assign", "LicensingAdmin", new { id = Model.Id })"
                  hx-target="#license-details-body"
                  hx-swap="innerHTML">
                @Html.AntiForgeryToken()
                <input type="hidden" name="context" value="details" />
                @if (selectedGroupId is not null)
                {
                    <input type="hidden" name="groupId" value="@selectedGroupId" />
                }

                <div class="flex items-center gap-2">
                    <input name="email" type="email" required placeholder="@T["LicensingAdmin.Index.Assign.Placeholder"]" />
                    <button type="submit" class="app-btn-secondary whitespace-nowrap">@T["LicensingAdmin.Index.Assign.Button"]</button>
                </div>
            </form>
        }
        else
        {
            <form method="post"
                  class="app-form"
                  hx-post="@Url.Action("Reassign", "LicensingAdmin", new { id = Model.Id })"
                  hx-target="#license-details-body"
                  hx-swap="innerHTML">
                @Html.AntiForgeryToken()
                <input type="hidden" name="context" value="details" />
                @if (selectedGroupId is not null)
                {
                    <input type="hidden" name="groupId" value="@selectedGroupId" />
                }

                <div class="flex items-center gap-2">
                    <input name="email" type="email" required placeholder="@T["LicensingAdmin.Index.Reassign.Placeholder"]" />
                    <button type="submit" class="app-btn-secondary whitespace-nowrap">@T["LicensingAdmin.Index.Reassign.Button"]</button>
                </div>
            </form>

            <form method="post"
                  class="app-form"
                  hx-post="@Url.Action("Unassign", "LicensingAdmin", new { id = Model.Id })"
                  hx-target="#license-details-body"
                  hx-swap="innerHTML">
                @Html.AntiForgeryToken()
                <input type="hidden" name="context" value="details" />
                @if (selectedGroupId is not null)
                {
                    <input type="hidden" name="groupId" value="@selectedGroupId" />
                }

                <button type="submit" class="app-btn-secondary whitespace-nowrap">@T["LicensingAdmin.Index.Unassign.Button"]</button>
            </form>
        }

        <authorize policy="@Authz.Policies.LicensingAdmin">
            @if (Model.IsRevoked)
            {
                <form method="post"
                      class="app-form"
                      hx-post="@Url.Action("Unrevoke", "LicensingAdmin", new { id = Model.Id })"
                      hx-target="#license-details-body"
                      hx-swap="innerHTML">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="context" value="details" />
                    @if (selectedGroupId is not null)
                    {
                        <input type="hidden" name="groupId" value="@selectedGroupId" />
                    }
                    <button type="submit" class="app-btn-secondary whitespace-nowrap">@T["LicensingAdmin.Index.Action.Unrevoke"]</button>
                </form>
            }
            else
            {
                <form method="post"
                      class="app-form"
                      hx-post="@Url.Action("Revoke", "LicensingAdmin", new { id = Model.Id })"
                      hx-target="#license-details-body"
                      hx-swap="innerHTML">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="context" value="details" />
                    @if (selectedGroupId is not null)
                    {
                        <input type="hidden" name="groupId" value="@selectedGroupId" />
                    }
                    <button type="submit" class="app-btn-secondary whitespace-nowrap">@T["LicensingAdmin.Index.Action.Revoke"]</button>
                </form>
            }
        </authorize>

        <authorize roles="@Authz.Roles.Admin">
            <form method="post"
                  class="app-form"
                  hx-post="@Url.Action("Transfer", "LicensingAdmin", new { id = Model.Id })"
                  hx-target="#license-details-body"
                  hx-swap="innerHTML">
                @Html.AntiForgeryToken()
                <input type="hidden" name="context" value="details" />
                @if (selectedGroupId is not null)
                {
                    <input type="hidden" name="groupId" value="@selectedGroupId" />
                }

                <div class="flex items-center gap-2">
                    <select name="toGroupId" class="min-w-64">
                        @if (groups is not null)
                        {
                            foreach (var g in groups)
                            {
                                if (g.Id == Model.GroupId)
                                {
                                    <option value="@g.Id" selected>@g.Name</option>
                                }
                                else
                                {
                                    <option value="@g.Id">@g.Name</option>
                                }
                            }
                        }
                    </select>
                    <button type="submit" class="app-btn-secondary whitespace-nowrap">Přesunout</button>
                </div>
            </form>
        </authorize>
    </div>
</div>

@*
Podrobnosti (k čemu slouží, volání, data, HTMX)

- Účel:
    - Partial pro detail konkrétního licenčního klíče (serial number):
        - stav (revoked/active), max zařízení, vytvoření, přiřazení na uživatele,
        - akce Assign/Reassign/Unassign, Revoke/Unrevoke a (pro Admin) Transfer mezi skupinami.
    - Renderuje se typicky do dialogu (viz `#license-details-body` v hlavních stránkách).

- Kdy / jak / kým je volán:
    - Volá se z detail endpointu typu `LicensingAdminController.Details(id, groupId?)`, který vrací tento partial.
    - Akční formuláře volají POST endpointy `Assign/Reassign/Unassign/Revoke/Unrevoke/Transfer`.
    - Kdo může vidět které akce:
        - Assign/Reassign/Unassign jsou dostupné podle toho, zda je klíč přiřazen.
        - Revoke/Unrevoke je schované za policy `LicensingAdmin`.
        - Transfer je dostupný jen pro roli Admin.

- Datové napojení:
    - `@model SerialNumberModel`: detail klíče včetně `OwnerUser` a `GroupId`.
    - `ViewData["SelectedGroupId"]`: zachování kontextu filtru (posílá se zpět jako hidden `groupId`).
    - `ViewData["KeyGroups"]`: seznam skupin pro select v Transfer.
    - `_Toast` může zobrazovat výsledky akcí (TempData) i uvnitř detailu.
    - V každém POST formuláři je `@Html.AntiForgeryToken()`.
    - Hidden `context="details"` říká serveru, že odpověď má být detail partial (ne např. full redirect).

- HTMX prvky a princip:
    - Všechny akce jsou dělané přes HTMX, aby se aktualizoval jen detail v dialogu:
        - `hx-target="#license-details-body"` + `hx-swap="innerHTML"`.
    - To znamená:
        - server po POST vrátí znovu `_Details` (aktuální stav po akci),
        - HTMX přepíše obsah detailu bez zavření dialogu.
*@
