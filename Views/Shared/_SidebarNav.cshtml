@using DigitalniProdukty.Security
@inject Microsoft.Extensions.Localization.IStringLocalizer<DigitalniProdukty.SharedResources> T

@{
    var currentController = (ViewContext.RouteData.Values["controller"] as string) ?? string.Empty;
    var currentAction = (ViewContext.RouteData.Values["action"] as string) ?? string.Empty;

    string navItemClass(string controller, string action)
    {
        var isActive = string.Equals(currentController, controller, global::System.StringComparison.OrdinalIgnoreCase)
                       && string.Equals(currentAction, action, global::System.StringComparison.OrdinalIgnoreCase);
        return isActive ? "app-nav-link app-nav-link-active" : "app-nav-link";
    }
}

<nav class="p-3 space-y-1" preload="mousedown" hx-target="#main" hx-swap="innerHTML">
    <a class='@navItemClass("Home", "Index")'
       asp-area="" asp-controller="Home" asp-action="Index"
       preload>
        <svg class="h-5 w-5 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M4 11l8-7 8 7" />
            <path d="M6 10.5V20h12v-9.5" />
            <path d="M10 20v-6h4v6" />
        </svg>
        <span>@T["Nav.Home"]</span>
    </a>

    <authorize>
        <a class='@navItemClass("Home", "Privacy")'
           asp-area="" asp-controller="Home" asp-action="Privacy"
           preload>
            <svg class="h-5 w-5 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M8 11V8a4 4 0 0 1 8 0v3" />
                <path d="M7 11h10v9H7z" />
                <path d="M12 15v2" />
            </svg>
            <span>@T["Nav.Privacy"]</span>
        </a>
    </authorize>

    <authorize>
        <a class='@navItemClass("Account", "Serials")'
           asp-area="" asp-controller="Account" asp-action="Serials"
           preload>
            <svg class="h-5 w-5 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="7.5" cy="14.5" r="3.5" />
                <path d="M11 14.5H22v3l-2 2v2h-3v-3h-3" />
            </svg>
            <span>@T["Account.Nav.Serials"]</span>
        </a>
    </authorize>

    <authorize policy="@Authz.Policies.SerialNumbers_Sell">
        <a class='@navItemClass("LicensingAdmin", "Index")'
           asp-area="" asp-controller="LicensingAdmin" asp-action="Index"
           preload>
            <svg class="h-5 w-5 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="4" cy="6" r="1" />
                <circle cx="4" cy="12" r="1" />
                <circle cx="4" cy="18" r="1" />
                <path d="M8 6h13" />
                <path d="M8 12h13" />
                <path d="M8 18h13" />
            </svg>
            <span>@T["Nav.Licensing.Manage"]</span>
        </a>
    </authorize>

    <authorize policy="@Authz.Policies.SerialNumbers_Generate">
        <a class='@navItemClass("LicensingAdmin", "GeneratePage")'
           asp-area="" asp-controller="LicensingAdmin" asp-action="GeneratePage"
           preload>
            <svg class="h-5 w-5 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2" />
                <path d="M12 8v8" />
                <path d="M8 12h8" />
            </svg>
            <span>@T["Nav.Licensing.Generate"]</span>
        </a>
    </authorize>

    <authorize policy="@Authz.Policies.LicensingAdmin">
        <a class='@navItemClass("LicensingAdmin", "Installations")'
           asp-area="" asp-controller="LicensingAdmin" asp-action="Installations"
           preload>
            <svg class="h-5 w-5 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v6l4 2" />
            </svg>
            <span>@T["LicensingAdmin.Index.Button.Installations"]</span>
        </a>
    </authorize>

    <authorize policy="@Authz.Policies.Users_CreateEndUser">
        <a class='@navItemClass("Auth", "Register")'
           asp-area="" asp-controller="Auth" asp-action="Register"
           preload>
            <svg class="h-5 w-5 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                <circle cx="9" cy="7" r="4" />
                <path d="M19 8v6" />
                <path d="M22 11h-6" />
            </svg>
            <span>@T["Nav.CreateEndUser"]</span>
        </a>
    </authorize>

    <authorize roles="@Authz.Roles.Admin">
        <a class='@navItemClass("Admin", "Index")'
           asp-area="" asp-controller="Admin" asp-action="Index"
           preload>
            <svg class="h-5 w-5 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="7" r="4" />
                <path d="M5 21v-2a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v2" />
                <path d="M19 8v6" />
                <path d="M22 11h-6" />
            </svg>
            <span>@T["Nav.Admin.GroupsUsers"]</span>
        </a>
    </authorize>

    <authorize roles="@Authz.Roles.Owner">
        <a class='@navItemClass("Owner", "Index")'
           asp-area="" asp-controller="Owner" asp-action="Index"
           preload>
            <svg class="h-5 w-5 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2l3 7h7l-5.5 4 2.5 7-7-4-7 4 2.5-7L2 9h7z" />
            </svg>
            <span>@T["Nav.Owner.AdminManagement"]</span>
        </a>
    </authorize>
</nav>
