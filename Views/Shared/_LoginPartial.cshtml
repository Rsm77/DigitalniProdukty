@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject IStringLocalizer<SharedResources> T

<ul class="flex items-center gap-2" role="list">
@if (SignInManager.IsSignedIn(User))
{
    <li>
        <a class="app-btn-secondary inline-flex items-center justify-center gap-2" hx-target="#main" asp-controller="Account" asp-action="Profile" title="@T["Auth.Manage"]">
            <svg class="h-4 w-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                <circle cx="12" cy="7" r="4" />
            </svg>
            <span>@User.Identity?.Name</span>
        </a>
    </li>
    <li>
        <form class="inline" hx-boost="false" asp-controller="Auth" asp-action="Logout" asp-route-returnUrl="@Url.Content("~/")">
            <button type="submit" class="app-btn-secondary w-32 inline-flex items-center justify-center gap-2">
                <svg class="h-4 w-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <path d="M16 17l5-5-5-5" />
                    <path d="M21 12H9" />
                </svg>
                <span>@T["Auth.Logout"]</span>
            </button>
        </form>
    </li>
}
else
{
    <li>
        <a class="app-btn-secondary w-32 inline-flex items-center justify-center gap-2" hx-target="#main" asp-controller="Auth" asp-action="Login">
            <svg class="h-4 w-4 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                <path d="M10 17l5-5-5-5" />
                <path d="M15 12H3" />
            </svg>
            <span>@T["Auth.Login"]</span>
        </a>
    </li>
}
</ul>

@*
Podrobnosti (k čemu slouží, volání, data, HTMX)

- Účel:
    - Malý „login status“ blok do layoutu: podle přihlášení ukáže buď jméno uživatele + tlačítko odhlášení, nebo tlačítko pro přihlášení.

- Kdy / jak / kým je volán:
    - Vkládá se do layoutu přes `<partial name="_LoginPartial" />` v [Views/Shared/_Layout.cshtml](Views/Shared/_Layout.cshtml).
    - Layout navíc umí tento blok periodicky/událostně obnovit přes HTMX (endpoint `/_fragments/login`).

- Datové napojení:
    - `@inject SignInManager<IdentityUser>` + `@inject UserManager<IdentityUser>`: zjištění stavu přihlášení a (případně) práce s uživatelem.
    - `SignInManager.IsSignedIn(User)` rozhoduje, zda se renderuje „signed-in“ nebo „signed-out“ varianta.
    - Texty jsou lokalizované přes `IStringLocalizer<SharedResources> T`.

- HTMX prvky a princip:
    - Odkazy mají `hx-target="#main"` (v kombinaci s globálním `hx-boost` v layoutu), takže navigace typicky mění jen obsah `#main`.
    - Logout je `<form>` s `hx-boost="false"`:
        - odhlášení se provede klasickým POSTem (bez HTMX boostu), aby byl tok odhlášení a redirect co nejjednodušší a kompatibilní.
*@
