@using Microsoft.Extensions.Localization
@using DigitalniProdukty.Models.Licensing
@inject IStringLocalizer<IdentityUi> T

@{
    var groups = ViewData["KeyGroups"] as IReadOnlyList<KeyGroupModel>;
}

<div id="target-group-slot">
@if (groups is not null)
{
    <div class="app-field">
        <label>@T["Identity.Register.TargetGroup.Label"]</label>
        <select name="TargetGroupId" id="TargetGroupId">
            <option value="">—</option>
            @foreach (var g in groups)
            {
                <option value="@g.Id">@g.Name</option>
            }
        </select>
        <span class="field-validation-valid" data-valmsg-for="TargetGroupId" data-valmsg-replace="true"></span>
        <div class="app-help">@T["Identity.Register.TargetGroup.Help"]</div>
    </div>
}
</div>
