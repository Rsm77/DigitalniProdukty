@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityUi> T

@{
    ViewData["Title"] = ViewData["Title"] ?? T["Identity.AccessDenied.Title"].Value;
}

<div class="app-card">
    <div class="app-card-header">
        <h1 class="app-card-title">@T["Identity.AccessDenied.Title"]</h1>
    </div>

    <div class="app-card-body space-y-4">
        <p class="text-sm text-slate-700">@T["Identity.AccessDenied.Description"]</p>

        <div class="flex items-center justify-end">
            <a class="app-btn-primary" asp-controller="Home" asp-action="Index">@T["Identity.AccessDenied.Button.Home"]</a>
        </div>
    </div>
</div>
