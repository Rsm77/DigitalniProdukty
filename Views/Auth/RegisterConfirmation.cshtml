@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityUi> T

@{
    ViewData["Title"] = ViewData["Title"] ?? T["Identity.RegisterConfirmation.Title"].Value;
    var email = (string?)ViewData["Email"] ?? string.Empty;
    var devLink = (string?)ViewData["DevLink"];
}

<div class="app-card">
    <div class="app-card-header">
        <h1 class="app-card-title">@T["Identity.RegisterConfirmation.Title"]</h1>
    </div>

    <div class="app-card-body space-y-4">
        <p class="text-sm text-slate-600">@T["Identity.RegisterConfirmation.Description"]</p>

        <p class="text-sm text-slate-700">@T["Identity.RegisterConfirmation.Body.BeforeEmail"] <strong>@email</strong> @T["Identity.RegisterConfirmation.Body.AfterEmail"]</p>

        @if (!string.IsNullOrWhiteSpace(devLink))
        {
            <div class="app-callout app-callout-warning">
                <div class="font-medium">@T["Identity.DevMode.Title"]</div>
                <div class="mt-1">@T["Identity.DevMode.EmailNotConfigured.Confirm"]</div>
                <div class="mt-2 break-all"><a class="underline" href="@devLink">@devLink</a></div>
            </div>
        }

        <div class="flex flex-wrap items-center justify-end gap-2">
            <a class="app-btn-primary" asp-controller="Auth" asp-action="Login">@T["Identity.RegisterConfirmation.Button.ContinueToLogin"]</a>
            <a class="app-btn-secondary" asp-controller="Home" asp-action="Index">@T["Identity.RegisterConfirmation.Button.Back"]</a>
        </div>
    </div>
</div>

@*
Podrobnosti (k čemu slouží, volání, data, HTMX)

- Účel:
    - Potvrzovací stránka po registraci: informuje uživatele o odeslání potvrzovacího emailu.
    - V dev režimu umí zobrazit přímý potvrzovací link (`DevLink`), pokud není nakonfigurované odesílání emailu.

- Kdy / jak / kým je volán:
    - Typicky redirect z `AuthController.Register(...)` po úspěšném vytvoření účtu.

- Datové napojení:
    - `ViewData["Email"]`: email, na který byl poslán potvrzovací odkaz.
    - `ViewData["DevLink"]`: (volitelné) přímý odkaz pro vývojové prostředí.
    - Texty jsou lokalizované přes `IStringLocalizer<IdentityUi>`.

- HTMX prvky a princip:
    - Tento view nepoužívá `hx-*` atributy; jde o statickou stránku.
    - Navigace tlačítky může být HTMX-boostnutá globálně layoutem.
*@
