@model DigitalniProdukty.Models.Auth.ResetPasswordInputModel
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityUi> T

@{
    ViewData["Title"] = ViewData["Title"] ?? T["Identity.ResetPassword.Title"].Value;
}

<div class="app-card" id="reset-password-card">
    <div class="app-card-header">
        <h1 class="app-card-title">@T["Identity.ResetPassword.Title"]</h1>
    </div>

    <div class="app-card-body">
        <p class="mb-6 text-sm text-slate-600">@T["Identity.ResetPassword.Description"]</p>

        <div asp-validation-summary="All" class="mb-4"></div>

        <form id="reset-password-form" 
              method="post" 
              class="app-form" 
              novalidate
              hx-post="@Url.Action("ResetPassword", "Auth")" 
              hx-target="#reset-password-card" 
              hx-swap="outerHTML"
              asp-action="ResetPassword">
            <input type="hidden" asp-for="Code" />

            <div class="app-form-section">
                <div class="app-form-section-heading">
                    <div class="app-form-section-title">@T["Identity.ResetPassword.Section.Account.Title"]</div>
                    <div class="app-form-section-help">@T["Identity.ResetPassword.Section.Account.Help"]</div>
                </div>

                <div class="app-form-section-fields">
                    <div class="app-field">
                        <label asp-for="Email"></label>
                        <input asp-for="Email" autocomplete="username" />
                        <span asp-validation-for="Email"></span>
                    </div>

                    <div class="app-field">
                        <label asp-for="Password"></label>
                        <input asp-for="Password" autocomplete="new-password" />
                        <span asp-validation-for="Password"></span>
                    </div>

                    <div class="app-field">
                        <label asp-for="ConfirmPassword"></label>
                        <input asp-for="ConfirmPassword" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword"></span>
                    </div>
                </div>
            </div>

            <div class="app-form-section">
                <div class="app-form-section-heading">
                    <div class="app-form-section-title">@T["Identity.ResetPassword.Section.Actions.Title"]</div>
                    <div class="app-form-section-help">@T["Identity.ResetPassword.Section.Actions.Help"]</div>
                </div>

                <div class="flex flex-wrap items-center justify-end gap-2">
                    <button type="submit" class="app-btn-primary">
                        <span class="htmx-indicator items-center gap-2">
                            <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                        </span>
                        <span class="htmx-content">@T["Identity.ResetPassword.Button.SavePassword"]</span>
                    </button>
                    <a class="app-btn-secondary" asp-controller="Auth" asp-action="Login">@T["Identity.ResetPassword.Button.BackToLogin"]</a>
                </div>
            </div>
        </form>
    </div>
</div>

@*
Podrobnosti (k čemu slouží, volání, data, HTMX)

- Účel:
    - Stránka pro nastavení nového hesla (přichází se sem z reset linku, který obsahuje token).

- Kdy / jak / kým je volán:
    - GET: `AuthController.ResetPassword(code)` připraví view (typicky předvyplní `Code`).
    - POST: `AuthController.ResetPassword(ResetPasswordInputModel)` ověří token a nastaví nové heslo.

- Datové napojení:
    - `@model ResetPasswordInputModel`:
        - `Email`, `Password`, `ConfirmPassword`.
        - `Code` je uložen jako hidden input (`<input type="hidden" asp-for="Code" />`).
    - Validační chyby jsou vykresleny přes `asp-validation-summary`/`asp-validation-for`.

- HTMX prvky a princip:
    - Formulář má `hx-post` + `hx-target="#reset-password-card"` + `hx-swap="outerHTML"`.
    - Umožňuje vrátit znovu kartu s chybami (např. neplatný token / slabé heslo) bez reloadu.
*@

