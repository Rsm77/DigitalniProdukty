@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityUi> T

@{
    ViewData["Title"] = ViewData["Title"] ?? T["Identity.ResetPasswordConfirmation.Title"].Value;
}

<div class="app-card">
    <div class="app-card-header">
        <h1 class="app-card-title">@T["Identity.ResetPasswordConfirmation.Title"]</h1>
    </div>

    <div class="app-card-body space-y-4">
        <p class="text-sm text-slate-600">@T["Identity.ResetPasswordConfirmation.Description"]</p>
        <p class="text-sm text-slate-700">@T["Identity.ResetPasswordConfirmation.Body"]</p>

        <div class="flex items-center justify-end">
            <a class="app-btn-primary" asp-controller="Auth" asp-action="Login">@T["Identity.ResetPasswordConfirmation.Button.GoToLogin"]</a>
        </div>
    </div>
</div>
