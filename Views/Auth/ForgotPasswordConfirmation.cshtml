@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityUi> T

@{
    ViewData["Title"] = ViewData["Title"] ?? T["Identity.ForgotPasswordConfirmation.Title"].Value;
    var devLink = (string?)ViewData["DevLink"];
}

<div class="app-card">
    <div class="app-card-header">
        <h1 class="app-card-title">@T["Identity.ForgotPasswordConfirmation.Title"]</h1>
    </div>

    <div class="app-card-body space-y-4">
        <p class="text-sm text-slate-600">@T["Identity.ForgotPasswordConfirmation.Description"]</p>
        <p class="text-sm text-slate-700">@T["Identity.ForgotPasswordConfirmation.Body"]</p>

        @if (!string.IsNullOrWhiteSpace(devLink))
        {
            <div class="app-callout app-callout-warning">
                <div class="font-medium">@T["Identity.DevMode.Title"]</div>
                <div class="mt-1">@T["Identity.DevMode.EmailNotConfigured.Reset"]</div>
                <div class="mt-2 break-all"><a class="underline" href="@devLink">@devLink</a></div>
            </div>
        }

        <div class="flex flex-wrap items-center justify-end gap-2">
            <a class="app-btn-primary" asp-controller="Auth" asp-action="Login">@T["Identity.ForgotPasswordConfirmation.Button.BackToLogin"]</a>
            <a class="app-btn-secondary" asp-controller="Home" asp-action="Index">@T["Identity.ForgotPasswordConfirmation.Button.Home"]</a>
        </div>
    </div>
</div>

@*
Podrobnosti (k čemu slouží, volání, data, HTMX)

- Účel:
    - Potvrzení po odeslání žádosti o reset hesla.
    - V dev režimu může zobrazit přímý reset link (`DevLink`), pokud email služba není nakonfigurovaná.

- Kdy / jak / kým je volán:
    - Typicky redirect z `AuthController.ForgotPassword(...)` po zpracování požadavku.

- Datové napojení:
    - `ViewData["DevLink"]`: (volitelné) přímý link pro vývoj.
    - Texty jsou z `IStringLocalizer<IdentityUi>`.

- HTMX prvky a princip:
    - Tento view nepoužívá `hx-*`; jde o statickou potvrzovací stránku.
*@
