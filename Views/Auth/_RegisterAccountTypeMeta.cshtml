@model DigitalniProdukty.Models.Auth.RegisterInputModel
@using Microsoft.Extensions.Localization
@using DigitalniProdukty.Models.Licensing
@using DigitalniProdukty.Security
@inject IStringLocalizer<IdentityUi> T

@{
    var accountType = (Model.AccountType ?? string.Empty).Trim();
    var showDisplayName = string.Equals(accountType, Authz.Roles.Distributor, StringComparison.Ordinal)
                          || string.Equals(accountType, Authz.Roles.Reseller, StringComparison.Ordinal);
    var showTargetGroup = !string.Equals(accountType, Authz.Roles.Distributor, StringComparison.Ordinal);

    var groups = ViewData["KeyGroups"] as IReadOnlyList<KeyGroupModel>;
}

<div id="register-accounttype-meta">
@if (showDisplayName)
{
    <div class="app-field">
        <label>@T["Identity.Register.DisplayName.Label"]</label>
        <input asp-for="DisplayName" autocomplete="organization" />
        <span asp-validation-for="DisplayName"></span>
        <div class="app-help">@T["Identity.Register.DisplayName.Help"]</div>
    </div>
}

@if (showTargetGroup && groups is not null)
{
    <div class="app-field">
        <label>@T["Identity.Register.TargetGroup.Label"]</label>
        <select asp-for="TargetGroupId">
            <option value="">—</option>
            @foreach (var g in groups)
            {
                if (Model.TargetGroupId == g.Id)
                {
                    <option value="@g.Id" selected>@g.Name</option>
                }
                else
                {
                    <option value="@g.Id">@g.Name</option>
                }
            }
        </select>
        <span asp-validation-for="TargetGroupId"></span>
        <div class="app-help">@T["Identity.Register.TargetGroup.Help"]</div>
    </div>
}
</div>

@*
Podrobnosti (k čemu slouží, volání, data, HTMX)

- Účel:
    - Partial s doplňkovými poli registrace, která se mění podle `AccountType`.
    - Umožňuje „serverem řízené UI“: server rozhodne, která pole mají být vidět a jaké mají možnosti.

- Kdy / jak / kým je volán:
    - Poprvé se vloží do [Views/Auth/Register.cshtml](Views/Auth/Register.cshtml) přes `@await Html.PartialAsync("_RegisterAccountTypeMeta", Model)`.
    - Následně se znovu načítá přes HTMX při `load` a při změně `<select asp-for="AccountType">`:
        endpoint je `AuthController.RegisterAccountTypeMeta(...)`.

- Datové napojení:
    - `@model RegisterInputModel`:
        - `AccountType` řídí, zda se zobrazí `DisplayName` a `TargetGroupId`.
        - `DisplayName` se binduje přes `asp-for` (a má vlastní validaci).
        - `TargetGroupId` se binduje přes `asp-for` a jeho možnosti se berou z `ViewData["KeyGroups"]`.
    - `ViewData["KeyGroups"] as IReadOnlyList<KeyGroupModel>` poskytuje seznam skupin pro `<select>`.

- HTMX prvky a princip:
    - Tento partial sám `hx-*` atributy nemá, ale je cílem HTMX swappu:
        - v Register view se cíluje přes `hx-target="#register-accounttype-meta"` a swapuje se `outerHTML`.
    - Díky tomu se při změně typu účtu aktualizuje jen tento blok, ne celá stránka.
*@
