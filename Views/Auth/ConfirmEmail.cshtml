@using Microsoft.Extensions.Localization
@inject IStringLocalizer<IdentityUi> T

@{
    ViewData["Title"] = ViewData["Title"] ?? T["Identity.ConfirmEmail.Title"].Value;
    var status = (string?)ViewData["ConfirmEmailStatus"] ?? string.Empty;
    var statusKind = (string?)ViewData["ConfirmEmailStatusKind"] ?? "info";
    var statusClass = statusKind switch
    {
        "success" => "app-callout-success",
        "error" => "app-callout-error",
        "warning" => "app-callout-warning",
        _ => "app-callout-info"
    };
}

<div class="app-card">
    <div class="app-card-header">
        <h1 class="app-card-title">@T["Identity.ConfirmEmail.Title"]</h1>
    </div>

    <div class="app-card-body space-y-4">
        <p class="text-sm text-slate-600">@T["Identity.ConfirmEmail.Description"]</p>

        @if (!string.IsNullOrWhiteSpace(status))
        {
            <div class="app-callout @statusClass">@status</div>
        }

        <div class="flex flex-wrap items-center justify-end gap-2">
            <a class="app-btn-primary" asp-controller="Auth" asp-action="Login">@T["Identity.ConfirmEmail.Button.GoToLogin"]</a>
            <a class="app-btn-secondary" asp-controller="Home" asp-action="Index">@T["Identity.ConfirmEmail.Button.Home"]</a>
        </div>
    </div>
</div>

@*
Podrobnosti (k čemu slouží, volání, data, HTMX)

- Účel:
    - Stránka pro potvrzení emailu: zobrazí stav potvrzení (success/error/warning/info).
    - Status text se nastavuje na serveru podle výsledku ověření tokenu.

- Kdy / jak / kým je volán:
    - Typicky se sem přichází přes odkaz z potvrzovacího emailu (GET na `AuthController.ConfirmEmail(userId, code)`).
    - Controller nastaví `ViewData` se zprávou a variantou.

- Datové napojení:
    - `ViewData["ConfirmEmailStatus"]`: text zprávy.
    - `ViewData["ConfirmEmailStatusKind"]`: typ (success/error/warning/info) → mapuje se na CSS `app-callout-*`.

- HTMX prvky a princip:
    - View nepoužívá `hx-*`; jde o stránku se stavem a odkazy dál.
*@
